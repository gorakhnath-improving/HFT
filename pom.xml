<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.finex</groupId>
    <artifactId>finex-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>FinEx</name>
    <description>High-performance simulated financial exchange and trading infrastructure platform</description>

    <properties>
        <java.version>25</java.version>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <spring-boot.version>4.1.1</spring-boot.version>
    </properties>

    <modules>
        <module>finex-common</module>
        <module>finex-order-book</module>
        <module>finex-matching-engine</module>
        <module>finex-risk</module>
        <module>finex-market-data</module>
        <module>finex-protocol</module>
        <module>finex-event-log</module>
        <module>finex-shard</module>
        <module>finex-ledger</module>
        <module>finex-portfolio</module>
        <module>finex-clearing</module>
        <module>finex-settlement</module>
        <module>finex-api</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>com.finex</groupId>
                <artifactId>finex-common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.finex</groupId>
                <artifactId>finex-order-book</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.finex</groupId>
                <artifactId>finex-matching-engine</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.finex</groupId>
                <artifactId>finex-risk</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.finex</groupId>
                <artifactId>finex-market-data</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.finex</groupId>
                <artifactId>finex-protocol</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.finex</groupId>
                <artifactId>finex-event-log</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.finex</groupId>
                <artifactId>finex-shard</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.finex</groupId>
                <artifactId>finex-ledger</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.finex</groupId>
                <artifactId>finex-portfolio</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.finex</groupId>
                <artifactId>finex-clearing</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.finex</groupId>
                <artifactId>finex-settlement</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>${spring-boot.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
